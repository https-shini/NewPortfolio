# Testes das funções serverless não vão para o deploy.
# O prefixo `_` já os tira do roteamento, mas eles importam `vitest`,
# que só existe em node_modules — mantê-los fora do envio
# elimina qualquer chance de o builder tentar compilá-los.
api/*.test.ts

# Pastas preexistentes de outros projetos: preservadas localmente, fora do deploy.
backend/
frontend/
# Referências do TCC não são assets públicos nem entradas do portfólio.
code-validator-main/
tcc-reference/
*.zip
*.rar
