{
    "name": "NewPortfolio",
    "private": true,
    "type": "module",
    "version": "2.0.0",
    "description": "Portfolio pessoal de Guilherme Cruz",
    "author": "Guilherme Cruz",
    "license": "MIT",
    "packageManager": "npm@11.6.2",
    "engines": {
        "node": "^22.22.1 || ^24.11.1",
        "npm": ">=11.6.2"
    },
    "scripts": {
        "dev": "npm run dev --workspace apps/web",
        "build": "npm run build --workspace apps/web",
        "preview": "npm run preview --workspace apps/web",
        "clean": "node scripts/clean.mjs",
        "clean:dist": "node scripts/clean.mjs --dist-only",
        "type-check": "npm run type-check --workspace apps/web",
        "lint": "npm run lint --workspace apps/web",
        "lint:fix": "npm run lint:fix --workspace apps/web",
        "format": "node scripts/format.mjs --write",
        "format:check": "node scripts/format.mjs --check",
        "verify": "node scripts/verify.mjs",
        "test": "npm run test --workspace apps/web",
        "test:watch": "npm run test:watch --workspace apps/web",
        "audit:a11y": "node scripts/a11y.mjs",
        "audit:overflow": "node scripts/overflow.mjs",
        "audit:release-notes": "node --experimental-strip-types --no-warnings scripts/e2e-release-notes.mjs",
        "audit:not-found": "node scripts/e2e-not-found.mjs",
        "audit:linkedin": "node scripts/e2e-linkedin.mjs",
        "audit:codex": "node scripts/e2e-codex.mjs",
        "audit:bundle": "node scripts/bundle-budget.mjs",
        "audit:modals": "node scripts/e2e-modals.mjs",
        "audit:perf": "node scripts/perf.mjs",
        "audit:layers": "node scripts/layers.mjs",
        "audit:identity": "node scripts/identity.mjs",
        "icones": "node scripts/icones.mjs",
        "icones:check": "node scripts/icones.mjs --check",
        "imagens": "node scripts/imagens.mjs",
        "imagens:check": "node scripts/imagens.mjs --check",
        "csp:check": "node scripts/csp.mjs --check",
        "changelog": "node --experimental-strip-types --no-warnings scripts/changelog.mjs",
        "changelog:check": "node --experimental-strip-types --no-warnings scripts/changelog.mjs --check",
        "prepare": "husky"
    },
    "lint-staged": {
        "apps/web/src/**/*.{ts,tsx,css}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "axe-core": "^4.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "playwright": "^1.62.1",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@vercel/og": "1.0.1"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ]
}
