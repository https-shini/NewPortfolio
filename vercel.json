{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "outputDirectory": "apps/web/dist",
    "rewrites": [
        {
            "source": "/feed.xml",
            "destination": "/api/feed"
        },
        {
            "source": "/links",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|slack-imgproxy|whatsapp|discordbot|telegrambot|redditbot|pinterest|skypeuripreview|embedly|quora link preview|nuzzel|bitlybot|vkshare|mastodon|bluesky).*"
                }
            ],
            "destination": "/api/crawler?path=/links"
        },
        {
            "source": "/release-notes",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|slack-imgproxy|whatsapp|discordbot|telegrambot|redditbot|pinterest|skypeuripreview|embedly|quora link preview|nuzzel|bitlybot|vkshare|mastodon|bluesky).*"
                }
            ],
            "destination": "/api/crawler?path=/release-notes"
        },
        {
            "source": "/release-notes/:rest*",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|slack-imgproxy|whatsapp|discordbot|telegrambot|redditbot|pinterest|skypeuripreview|embedly|quora link preview|nuzzel|bitlybot|vkshare|mastodon|bluesky).*"
                }
            ],
            "destination": "/api/crawler?path=/release-notes/:rest*"
        },
        {
            "source": "/contato",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|slack-imgproxy|whatsapp|discordbot|telegrambot|redditbot|pinterest|skypeuripreview|embedly|quora link preview|nuzzel|bitlybot|vkshare|mastodon|bluesky).*"
                }
            ],
            "destination": "/api/crawler?path=/contato"
        },
        {
            "source": "/links",
            "destination": "/links.html"
        },
        {
            "source": "/links/",
            "destination": "/links.html"
        },
        {
            "source": "/release-notes",
            "destination": "/release-notes.html"
        },
        {
            "source": "/release-notes/",
            "destination": "/release-notes.html"
        },
        {
            "source": "/release-notes/(.*)",
            "destination": "/release-notes.html"
        },
        {
            "source": "/contato",
            "destination": "/contato.html"
        },
        {
            "source": "/contato/",
            "destination": "/contato.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy-Report-Only",
                    "value": "default-src 'self'; script-src 'self' 'sha256-yUYxM2EpJKkRF4zKR8ew5RWXmfrKyv7zipm0rvDmhYI='; style-src 'self' 'unsafe-inline' https://api.fontshare.com; font-src 'self' https://cdn.fontshare.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; report-uri /api/csp-report; report-to csp"
                },
                {
                    "key": "Reporting-Endpoints",
                    "value": "csp=\"/api/csp-report\""
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), microphone=(), midi=(), payment=(), usb=()"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
